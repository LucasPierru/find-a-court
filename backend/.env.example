PORT=4000

# postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/find_a_court

CORS_ORIGIN=http://localhost:3000

# Signing secrets for JWTs - generate real random values for anything beyond
# local dev, e.g. `openssl rand -hex 32`.
ACCESS_TOKEN_SECRET=T>9&&eC_fO/^naD*
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_SECRET=;S4In|qc{zPLG%/e
REFRESH_TOKEN_TTL_DAYS=30

# OTP login has no real email provider wired up yet: every request accepts
# this fixed code instead of emailing one. Replace with real generation +
# sending before this goes anywhere beyond a personal showcase.
OTP_STATIC_CODE=000000
OTP_TTL_MINUTES=10
